{
  "name": "iltumio/siwe-php",
  "description": "Sign In With Ethereum porting for PHP",
  "type": "library",
  "version": "0.2.0",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-gmp": "*",
    "kornrunner/keccak": "^1.1",
    "simplito/elliptic-php": "^1.0.12",
    "guzzlehttp/guzzle": "^7.15.2",
    "guzzlehttp/promises": "^2.5.3",
    "nesbot/carbon": "^3.14",
    "ext-ctype": "*"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Iltumio\\SiwePhp\\": "src/"
    },
    "classmap": [
      "src/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Iltumio\\SiwePhp\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "iltumio.eth",
      "email": "manuel.tumiati@knobs.it"
    }
  ],
  "require-dev": {
    "phpunit/phpunit": "^12.5.8"
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  }
}
